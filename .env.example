# BRCA Review only: copy to .env and replace the password placeholder.
# Do not copy credentials from BKP. Use a shell-safe, independently generated value.
BRCA_POSTGRES_DB=brca_review
BRCA_POSTGRES_USER=brca_review
BRCA_POSTGRES_PASSWORD=replace_with_a_unique_random_password
BRCA_POSTGRES_HOST=127.0.0.1
BRCA_POSTGRES_PORT=5433
# Optional standalone frontend port; Compose file: compose.frontend.yaml
BRCA_FRONTEND_PORT=8091

# Read-only API: localhost host port; frontend uses same-origin /api/v1.
BRCA_API_PORT=8093
