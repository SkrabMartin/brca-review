FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md requirements-web.lock ./
COPY src ./src
COPY alembic.ini ./
COPY migrations ./migrations
COPY docs/*.json ./docs/
RUN pip install --no-cache-dir -r requirements-web.lock && pip install --no-cache-dir --no-deps . && useradd --uid 10001 --create-home app
USER 10001
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=4)" || exit 1
CMD ["uvicorn", "brca_review.web.app:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
